# Copia questo file in .env.local e inserisci i valori reali.
# .env.local non viene mai committato (vedi .gitignore).

# Dominio pubblico del sito: usato per metadataBase, JSON-LD, sitemap.xml,
# robots.txt. Se assente, il codice ricade su https://agriasystem.com.
NEXT_PUBLIC_SITE_URL="https://agriasystem.com"

# Resend (https://resend.com) per l'invio email cliente + notifica team.
RESEND_API_KEY=""
# Indirizzo mittente: deve appartenere a un dominio verificato su Resend.
RESEND_FROM_EMAIL="proposte@tuodominio.it"
# Chi riceve la notifica di nuovo lead (più indirizzi separati da virgola).
# Se vuoto, usa site.email di content/site.js (info@agriasystem.com).
TEAM_NOTIFICATION_EMAIL=""

# Unsplash (https://unsplash.com/developers): chiave "Access Key" dell'applicazione,
# usata solo da scripts/fetch-images.mjs per cercare le foto e registrare i download.
UNSPLASH_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Modulo contatti → HubSpot (Prompt 15). Solo nomi: i valori stanno in
# .env.local e su Vercel, mai nel repository.
# Token della Private App HubSpot (ambiti: contatti, aziende, trattative in
# lettura e scrittura). Solo lato server.
HUBSPOT_PRIVATE_APP_TOKEN=
# reCAPTCHA v3: chiave pubblica (browser) e chiave segreta (solo server).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Soglia minima del punteggio reCAPTCHA (facoltativa, predefinita 0.5).
RECAPTCHA_MIN_SCORE=
# RESEND_API_KEY, RESEND_FROM_EMAIL e TEAM_NOTIFICATION_EMAIL (sopra) servono
# anche per la notifica al team di ogni richiesta dal modulo contatti.
# TEAM_NOTIFICATION_EMAIL accetta più indirizzi separati da virgola.

# Owner HubSpot di Matteo Garuzzo: riceve un task di controllo per ogni nuova
# richiesta dal sito ("Nuovo lead sito — [AZIENDA]"). Solo cifre: l'ID owner
# (non lo userId), da `node scripts/hubspot-owners.mjs`. Se vuota, nessun task.
HUBSPOT_MANAGER_OWNER_ID=
